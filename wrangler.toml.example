name = "ro-li-2d-designer"
compatibility_date = "2026-11-06"
pages_build_output_dir = "./dist"

[[d1_databases]]
binding = "SHOP_DB"
database_name = "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_NAME"
database_id = "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"
migrations_dir = "migrations"

[[r2_buckets]]
binding = "SHOP_ASSETS"
bucket_name = "REPLACE_WITH_CLOUDFLARE_R2_BUCKET"

[vars]
CF_ACCESS_TEAM_DOMAIN = "REPLACE_WITH_CLOUDFLARE_ACCESS_TEAM_DOMAIN"
CF_ACCESS_AUD = "REPLACE_WITH_CLOUDFLARE_ACCESS_APPLICATION_AUD"
